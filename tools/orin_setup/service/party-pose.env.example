# Settings for party-pose.service (issue #8). install_service.sh copies this to
# ~/.config/party-pose/party-pose.env if that file does not exist yet; edit that copy, then
#   sudo systemctl restart party-pose
# systemd env file syntax: KEY=value, no "export", quotes allowed.

# Arguments for poser.py. Later: add the venue profile here (issue #7).
POSER_ARGS="--platform orin --fullscreen --fps"

# The display is read from the running desktop session. These are only fallbacks if no
# session process (gnome-shell etc.) is found.
# DISPLAY=:0
# XAUTHORITY=/run/user/1000/gdm/Xauthority

# Seconds to wait for the desktop before failing (then systemd retries).
DISPLAY_WAIT=300

# Power mode the service expects; it only warns if different, never changes it.
EXPECTED_POWER_MODE=MAXN_SUPER
