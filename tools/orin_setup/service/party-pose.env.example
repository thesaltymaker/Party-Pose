# Settings for party-pose.service (issue #8). install_service.sh copies this to
# ~/.config/party-pose/party-pose.env if that file does not exist yet; edit that copy, then
#   sudo systemctl restart party-pose
# systemd env file syntax: KEY=value, no "export", quotes allowed.

# Arguments for poser.py, as run on the Orin (2026-10-18, issue #13). --mirror: people see themselves on the same
# side, like a mirror. --pipeline: the next frame's models run while this one is drawn. The person detector is the
# YOLOX tiny 288x480 model fed BGR, shrunk with pixel averaging; --face-keep -8 keeps a found face down to logit -8;
# --score-smooth/--smooth-*/--ghost-frames: smooth figures, fewer blinks; the batch, --detect-every and
# --hand-every/--face-every flags: replays at ~34 FPS with 3 dancers, ~31 with 4 people (docs/lessons-learned.md).
POSER_ARGS="--platform orin --fullscreen --fps --mirror --drop-still --black-bg --skelly --pipeline --detector yolox_t_body_head_hand_post_0299_0.4522_1x3x288x480_nhwc.onnx --detector-bgr --detector-area --face-keep -8 --score-smooth 0.05 --ghost-frames 8 --pose-batch 4 --hand-batch 4 --face-batch 4 --detect-every 3"

# The display is read from the running desktop session. These are only fallbacks if no
# session process (gnome-shell etc.) is found.
# DISPLAY=:0
# XAUTHORITY=/run/user/1000/gdm/Xauthority

# Seconds to wait for the desktop before failing (then systemd retries).
DISPLAY_WAIT=300

# Power mode the service expects; it only warns if different, never changes it.
EXPECTED_POWER_MODE=MAXN_SUPER
