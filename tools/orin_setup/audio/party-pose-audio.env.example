# Settings for party-pose-audio.service. install_audio_service.sh copies this to
# ~/.config/party-pose/party-pose-audio.env if that file does not exist yet; edit that copy, then
#   systemctl --user restart party-pose-audio
# systemd env file syntax: KEY=value, no "export", quotes allowed. "~" is not expanded by systemd,
# but the program expands it in MUSIC_DIR and PLAYLIST.

# Folder with the music files (.webm .m4a .mp3 .flac .ogg .opus .wav). Subfolders are not searched.
MUSIC_DIR=~/Projects/Video_Projects/Music

# Play order, always looping: sorted (filename order), random, or playlist (order of the PLAYLIST file).
MODE=sorted

# Used when MODE=playlist: one file name per line, relative to MUSIC_DIR; blank lines and lines starting with # are skipped.
# Default if unset or empty: playlist.m3u inside MUSIC_DIR.
# PLAYLIST=~/Projects/Video_Projects/Music/playlist.m3u

# Volume in percent (0-100), set on the speakers each time they are detected.
VOLUME=50

# A speaker is the audio output whose name contains this text (case-insensitive). The same text finds its buttons.
SINK_MATCH=usb
